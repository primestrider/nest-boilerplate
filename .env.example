NODE_ENV=development
PORT=3000
# Comma-separated, e.g. http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Matches docker-compose.yml; pool size via ?connectionLimit=10
DATABASE_URL=mysql://app:app@localhost:3306/app
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
